// Integer-only binary64 arithmetic embedded in GLSL; no Float64/Int64 capability.
"// Binary64 arithmetic using only 32-bit integer operations. Limbs are little-endian.\n"
"// A finite magnitude is normalized to bit 126; its exponent names that bit.\n"
"// Product and addend are combined before rounding, preserving fused DFMA.\n"
"uvec4 sf64_add128(uvec4 a, uvec4 b) {\n"
"    uvec4 z; uint carry = 0u;\n"
"    for (int i=0; i<4; ++i) { uint c0,c1; uint v=uaddCarry(a[i],b[i],c0); z[i]=uaddCarry(v,carry,c1); carry=c0|c1; }\n"
"    return z;\n"
"}\n"
"uvec4 sf64_sub128(uvec4 a, uvec4 b) {\n"
"    uvec4 z; uint borrow=0u;\n"
"    for (int i=0; i<4; ++i) { uint b0,b1; uint v=usubBorrow(a[i],b[i],b0); z[i]=usubBorrow(v,borrow,b1); borrow=b0|b1; }\n"
"    return z;\n"
"}\n"
"bool sf64_less128(uvec4 a,uvec4 b) {\n"
"    for(int i=3;i>=0;--i) if(a[i]!=b[i]) return a[i]<b[i]; return false;\n"
"}\n"
"int sf64_top(uvec4 a) { for(int i=3;i>=0;--i) if(a[i]!=0u) return i*32+findMSB(a[i]); return -1; }\n"
"uvec4 sf64_left(uvec4 a,int n) {\n"
"    if(n>=128) return uvec4(0u); if(n<=0) return a;\n"
"    uvec4 z=uvec4(0u); int words=n/32, bits=n&31;\n"
"    for(int i=0;i<4;++i) { int j=i-words; if(j>=0) { z[i]=a[j]<<uint(bits); if(bits!=0 && j>0) z[i]|=a[j-1]>>uint(32-bits); } }\n"
"    return z;\n"
"}\n"
"uvec4 sf64_right(uvec4 a,int n) {\n"
"    if(n>=128) return uvec4(0u); if(n<=0) return a;\n"
"    uvec4 z=uvec4(0u); int words=n/32,bits=n&31;\n"
"    for(int i=0;i<4;++i) { int j=i+words; if(j<4) { z[i]=a[j]>>uint(bits); if(bits!=0 && j<3) z[i]|=a[j+1]<<uint(32-bits); } }\n"
"    return z;\n"
"}\n"
"bool sf64_below(uvec4 a,int n) {\n"
"    if(n<=0)return false; if(n>=128)return any(notEqual(a,uvec4(0u)));\n"
"    int words=n/32,bits=n&31;\n"
