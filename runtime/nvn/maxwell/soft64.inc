"    uint outsign=(sign>>31u)<<uint(fraction+ebits);\n"
"    if(sf64_nan(a))return outsign|(uint(emax-emin+2)<<uint(fraction))|(1u<<uint(fraction-1));\n"
"    if(sf64_inf(a))return outsign|(uint(emax-emin+2)<<uint(fraction));\n"
"    if(sf64_zero(a))return outsign;\n"
"    int e;uvec2 sig=sf64_decode(a,e);uvec3 z=sf64_round(sign,sf64_left(uvec4(sig,0u,0u),74),e,sig_bits,emin,emax,mode);\n"
