"uvec2 sf64_neg(uvec2 a) { return uvec2(a.x,a.y^0x80000000u); }\n"
"uvec2 sf64_abs(uvec2 a) { return uvec2(a.x,a.y&0x7fffffffu); }\n"
"uvec2 sf64_sat(uvec2 a) {\n"
"    if(sf64_nan(a) || (a.y&0x80000000u)!=0u)return uvec2(0u);\n"
"    return a.y>=0x3ff00000u?uvec2(0u,0x3ff00000u):a;\n"
