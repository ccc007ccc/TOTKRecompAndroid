"}\n"
"bool sf64_bit(uvec4 a,int n) { return n>=0 && n<128 && ((a[n/32]>>uint(n&31))&1u)!=0u; }\n"
"uvec4 sf64_jam(uvec4 a,int n) { uvec4 z=sf64_right(a,n); if(sf64_below(a,n))z.x|=1u; return z; }\n"
"uvec4 sf64_mul128(uvec2 a,uvec2 b) {\n"
"    uvec4 z=uvec4(0u);\n"
"    for(int i=0;i<2;++i) for(int j=0;j<2;++j) { uint hi,lo; umulExtended(a[i],b[j],hi,lo); uvec4 v=uvec4(0u);v[i+j]=lo;v[i+j+1]=hi;z=sf64_add128(z,v); }\n"
"    return z;\n"
"}\n"
"bool sf64_nan(uvec2 a) { return (a.y&0x7ff00000u)==0x7ff00000u && (a.x|(a.y&0xfffffu))!=0u; }\n"
"bool sf64_inf(uvec2 a) { return (a.y&0x7fffffffu)==0x7ff00000u && a.x==0u; }\n"
"bool sf64_zero(uvec2 a) { return (a.x|(a.y&0x7fffffffu))==0u; }\n"
