"uvec2 sf64_decode(uvec2 a,out int exponent) {\n"
"    int e=int((a.y>>20u)&2047u); uvec2 sig=uvec2(a.x,a.y&0xfffffu);\n"
"    exponent=e==0?-1022:e-1023;\n"
"    if(e!=0)sig.y|=0x100000u;\n"
"    else if(any(notEqual(sig,uvec2(0u)))) { int n=52-sf64_top(uvec4(sig,0u,0u));sig=sf64_left(uvec4(sig,0u,0u),n).xy;exponent-=n; }\n"
"    return sig;\n"
"}\n"
"// mode follows Maxwell: 0 nearest-even, 1 down, 2 up, 3 toward zero.\n"
"// Returns rounded significand and biased exponent (with zero/subnormal/overflow).\n"
"uvec3 sf64_round(uint sign,uvec4 mag,int exponent,int sig_bits,int emin,int emax,uint mode) {\n"
"    int top=sf64_top(mag);if(top<0)return uvec3(0u);\n"
"    exponent+=top-126;\n"
"    int shift=top-(sig_bits-1)+max(emin-exponent,0);\n"
"    uvec4 retained=shift>=0?sf64_right(mag,shift):sf64_left(mag,-shift);\n"
"    bool lost=sf64_below(mag,shift), guard_bit=sf64_bit(mag,shift-1);\n"
"    bool increment=mode==0u?(guard_bit&&(sf64_below(mag,shift-1)||(retained.x&1u)!=0u)):\n"
"        lost&&((mode==1u&&sign!=0u)||(mode==2u&&sign==0u));\n"
"    if(increment)retained=sf64_add128(retained,uvec4(1u,0u,0u,0u));\n"
"    if(exponent<emin)exponent=sf64_bit(retained,sig_bits-1)?emin:emin-1;\n"
"    else if(sf64_bit(retained,sig_bits)) {retained=sf64_right(retained,1);++exponent;}\n"
"    if(exponent>emax) {\n"
"        bool infinity=mode==0u||(mode==1u&&sign!=0u)||(mode==2u&&sign==0u);\n"
"        if(infinity)return uvec3(0u,0u,uint(emax-emin+2));\n"
"        retained=sf64_sub128(sf64_left(uvec4(1u,0u,0u,0u),sig_bits),uvec4(1u,0u,0u,0u));\n"
"        exponent=emax;\n"
"    }\n"
"    return uvec3(retained.xy,uint(exponent-emin+1));\n"
"}\n"
"uvec2 sf64_pack(uint sign,uvec4 mag,int exponent,uint mode) {\n"
"    uvec3 z=sf64_round(sign,mag,exponent,53,-1022,1023,mode);\n"
"    return uvec2(z.x,sign|(z.z<<20u)|(z.y&0xfffffu));\n"
"}\n"
"uvec2 sf64_combine(uint sa,uvec4 a,int ea,uint sb,uvec4 b,int eb,uint mode) {\n"
"    int e=max(ea,eb);a=sf64_jam(a,e-ea);b=sf64_jam(b,e-eb);\n"
"    if(sa==sb)return sf64_pack(sa,sf64_add128(a,b),e,mode);\n"
"    if(all(equal(a,b)))return uvec2(0u,mode==1u?0x80000000u:0u);\n"
"    bool less=sf64_less128(a,b);return sf64_pack(less?sb:sa,less?sf64_sub128(b,a):sf64_sub128(a,b),e,mode);\n"
"}\n"
"uvec2 sf64_add(uvec2 a,uvec2 b,uint mode) {\n"
"    if(sf64_nan(a))return sf64_quiet(a);if(sf64_nan(b))return sf64_quiet(b);\n"
"    uint sa=a.y&0x80000000u,sb=b.y&0x80000000u;\n"
"    if(sf64_inf(a))return sf64_inf(b)&&sa!=sb?sf64_invalid():a;if(sf64_inf(b))return b;\n"
"    if(sf64_zero(a)&&sf64_zero(b))return uvec2(0u,sa==sb?sa:mode==1u?0x80000000u:0u);\n"
"    if(sf64_zero(a))return b;if(sf64_zero(b))return a;\n"
"    int ea,eb;uvec2 ma=sf64_decode(a,ea),mb=sf64_decode(b,eb);\n"
"    return sf64_combine(sa,sf64_left(uvec4(ma,0u,0u),74),ea,sb,sf64_left(uvec4(mb,0u,0u),74),eb,mode);\n"
"}\n"
"uvec4 sf64_product(uvec2 a,uvec2 b,out int e) {\n"
"    int ea,eb;uvec2 ma=sf64_decode(a,ea),mb=sf64_decode(b,eb);uvec4 m=sf64_mul128(ma,mb);\n"
"    int top=sf64_top(m);e=ea+eb+top-104;return sf64_left(m,126-top);\n"
"}\n"
"uvec2 sf64_mul(uvec2 a,uvec2 b,uint mode) {\n"
"    if(sf64_nan(a))return sf64_quiet(a);if(sf64_nan(b))return sf64_quiet(b);\n"
"    uint sign=(a.y^b.y)&0x80000000u;\n"
"    if(sf64_inf(a)||sf64_inf(b))return sf64_zero(a)||sf64_zero(b)?sf64_invalid():uvec2(0u,sign|0x7ff00000u);\n"
"    if(sf64_zero(a)||sf64_zero(b))return uvec2(0u,sign);\n"
"    int e;uvec4 m=sf64_product(a,b,e);return sf64_pack(sign,m,e,mode);\n"
"}\n"
"uvec2 sf64_fma(uvec2 a,uvec2 b,uvec2 c,uint mode) {\n"
"    if(sf64_nan(a))return sf64_quiet(a);if(sf64_nan(b))return sf64_quiet(b);if(sf64_nan(c))return sf64_quiet(c);\n"
"    uint sign=(a.y^b.y)&0x80000000u,sc=c.y&0x80000000u;\n"
"    if(sf64_inf(a)||sf64_inf(b)) {\n"
"        if(sf64_zero(a)||sf64_zero(b)||(sf64_inf(c)&&sign!=sc))return sf64_invalid();return uvec2(0u,sign|0x7ff00000u);\n"
"    }\n"
"    if(sf64_inf(c))return c;\n"
"    if(sf64_zero(a)||sf64_zero(b))return sf64_add(uvec2(0u,sign),c,mode);\n"
"    if(sf64_zero(c))return sf64_mul(a,b,mode);\n"
"    int ep,ec;uvec4 p=sf64_product(a,b,ep);uvec2 mc=sf64_decode(c,ec);\n"
"    return sf64_combine(sign,p,ep,sc,sf64_left(uvec4(mc,0u,0u),74),ec,mode);\n"
"}\n"
"uvec2 sf64_from_small(uint a,int fraction,int bias) {\n"
"    uint sign=(a>>uint(fraction+findMSB(uint(bias+1))+1))<<31u;\n"
"    uint mask=uint(bias*2+1), frac=a&((1u<<uint(fraction))-1u);int exp=int((a>>uint(fraction))&mask);\n"
"    if(exp==int(mask))return uvec2(0u,sign|0x7ff00000u|(frac!=0u?0x80000u:0u));\n"
"    if(exp==0 && frac==0u)return uvec2(0u,sign);\n"
"    int e=exp==0?1-bias:exp-bias;if(exp!=0)frac|=1u<<uint(fraction);\n"
"    else {int shift=fraction-findMSB(frac);frac<<=uint(shift);e-=shift;}\n"
"    uvec2 sig=sf64_left(uvec4(frac,0u,0u,0u),52-fraction).xy;\n"
"    return uvec2(sig.x,sign|(uint(e+1023)<<20u)|(sig.y&0xfffffu));\n"
"}\n"
"uvec2 sf64_from_f32(uint a) {\n"
