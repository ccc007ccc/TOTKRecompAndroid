# your own game files and what's made from them (building from source puts them here)
input/
/ROM/
# the BOTW dump (exefs/ + romfs/ under Dump/<title id>/): never committed
/Dump/
/drivers/
extracted/
generated/
generated-*/
/rando/
# Nintendo fonts (users import their own; only the README ships)
/fonts/*
!/fonts/README.md
# build output, caches, saves and settings
build/
/cache/
save/
/larecomp.ini
# tools and Python environments (machine-specific)
tools/venv/
venv/
__pycache__/
.DS_Store

# Local porting inputs, private keys, build scratch and device evidence.
/.work/
