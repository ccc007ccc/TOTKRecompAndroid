#version 450
layout(local_size_x=32) in;
layout(set=0, binding=0, std430) buffer Output { uint values[]; } outbuf;
layout(set=0, binding=1, std140) uniform Input { uint value; } inputbuf;
layout(set=0, binding=2) uniform usampler2D sampled;
layout(set=0, binding=3, r32ui) uniform uimage2D storage;
layout(push_constant) uniform Push { uint base; uint add; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    ivec2 xy = ivec2(i % 32, i / 32);
    uint value = inputbuf.value + pc.add + i + texelFetch(sampled, xy, 0).x;
    outbuf.values[pc.base + i] = value;
    imageStore(storage, xy, uvec4(value));
}
