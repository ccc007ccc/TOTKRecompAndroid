<?xml version="1.0" encoding="utf-8"?>
<!-- After SDL3's android-project template (3.4.16), with TOTKRecompAndroid's activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Loopback HTTP bridge to the Zepp app on this phone (enabled by the player). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep an explicitly started game-code build alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:appCategory="game"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">

        <!-- SDL hints (SDL_ENV.*): landscape only (SDL would allow any orientation for a resizable window) -->
        <meta-data android:name="SDL_ENV.SDL_ORIENTATIONS" android:value="LandscapeLeft LandscapeRight" />

        <!-- simpleperf over adb on release builds (CPU profiles: docs/las/ANDROID-PORT.md); nothing else changes -->
        <profileable android:shell="true" />

        <activity
            android:name=".BOTWRecompAndroidActivity"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <!-- the app icon's long-press shortcut: back to the system driver (res/xml/shortcuts.xml) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- the long-press "Choose driver" shortcut: a driver package picked before the game starts (no window of its
             own: the system's file picker, then the app again) -->
        <activity
            android:name=".DriverPickActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="true" />
        <service android:name=".BuildService" android:foregroundServiceType="dataSync" android:exported="false" />
    </application>
</manifest>
