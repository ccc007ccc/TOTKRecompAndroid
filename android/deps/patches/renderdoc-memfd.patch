+// A standalone replay host can supply the same adrenotools loader used to
+// capture. Loading the system ICD cannot replay custom-driver memory layouts.
+static void *replayVulkanLibrary = nullptr;
+extern "C" __attribute__((visibility("default"))) void RENDERDOC_SetReplayVulkanLibrary(void *library)
+{
+  replayVulkanLibrary = library;
+}
+
 void *LoadVulkanLibrary()
 {
+  if(replayVulkanLibrary)
+    return replayVulkanLibrary;
   return Process::LoadModule("libvulkan.so");
