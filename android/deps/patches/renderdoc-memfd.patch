+#if defined(__ANDROID__)
+// The embedding application owns an anonymous memfd for the whole capture.
+// RDCFile reopens it through procfs while writing sections, retaining the
+// standard compressed RDC format without a persistent staging file.
+static std::atomic<int> captureFileFD{-1};
+extern "C" __attribute__((visibility("default"))) int RENDERDOC_SetCaptureFileFD(int fd)
+{
+  if(fd >= 0 && fcntl(fd, F_GETFD) < 0)
+    return 0;
+  captureFileFD.store(fd);
+  return 1;
+}
+#endif
+
 RDOC_DEBUG_CONFIG(bool, Capture_Debug_SnapshotDiagnosticLog, false,
                   "Snapshot the diagnostic log at capture time and embed in the capture.");
 
@@ -1675,6 +1693,12 @@ RDCFile *RenderDoc::CreateRDC(RDCDriver driver, uint32_t frameNum, const FramePi
 
   m_CurrentLogFile = StringFormat::Fmt("%s%s.rdc", m_CaptureFileTemplate.c_str(), suffix.c_str());
 
+#if defined(__ANDROID__)
+  const int memoryFD = captureFileFD.load();
+  if(memoryFD >= 0)
+    m_CurrentLogFile = StringFormat::Fmt("/proc/self/fd/%d", memoryFD);
+#endif
+
   // make sure we don't stomp another capture if we make multiple captures in the same frame.
   {
     SCOPED_LOCK(m_CaptureLock);
@@ -1706,7 +1730,10 @@ RDCFile *RenderDoc::CreateRDC(RDCDriver driver, uint32_t frameNum, const FramePi
   ret->SetData(driver, ToStr(driver).c_str(), OSUtility::GetMachineIdent(), &outThumb, m_TimeBase,
                m_TimeFrequency);
 
-  FileIO::CreateParentDirectory(m_CurrentLogFile);
+#if defined(__ANDROID__)
+  if(memoryFD < 0)
+#endif
+    FileIO::CreateParentDirectory(m_CurrentLogFile);
 
   ret->Create(m_CurrentLogFile.c_str());
 
@@ -2215,6 +2242,18 @@ void RenderDoc::FinishCaptureWriting(RDCFile *rdc, uint32_t frameNumber)
       delete w;
     }
 
+#if defined(__ANDROID__)
+    if(captureFileFD.load() >= 0)
+    {
+      // The app selects and saves its three candidates. Do not advertise an
+      // ephemeral procfs path to remote clients or retain it in m_Captures.
+      RDCLOG("Written to application capture memory: %s", m_CurrentLogFile.c_str());
+      m_CaptureTitle.clear();
+      delete rdc;
+      RenderDoc::Inst().SetProgress(CaptureProgress::FileWriting, 1.0f);
+      return;
+    }
+#endif
     RDCLOG("Written to disk: %s", m_CurrentLogFile.c_str());
 
     CaptureData cap;
